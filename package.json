{
  "name": "docs.immudb.io",
  "version": "1.0.0",
  "description": "Immudb - The open-source immutable database",
  "main": "index.js",
  "scripts": {
    "dev": "vitepress dev",
    "dev:vitepress": "vitepress dev",
    "docs:dev": "vitepress dev",
    "docs:build": "NODE_OPTIONS='--max-old-space-size=8192' vitepress build",
    "docs:preview": "vitepress preview",
    "prebuild": "npm run images || true",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vitepress build",
    "build:vitepress": "vitepress build",
    "build:no-cache": "rm -rf .vitepress/cache && npm run build",
    "preview": "npm run build && vitepress preview",
    "preview:vitepress": "vitepress preview",
    "images": "npm run images:fullsize && npm run images:thumbnail",
    "images:fullsize": "sharp -i 'src/.vuepress/public/blog/*.{jpg,png,gif}' -o src/.vuepress/public/blog/fullsize/ resize 1920",
    "images:thumbnail": "sharp -i 'src/.vuepress/public/blog/*.{jpg,png,gif}' -o src/.vuepress/public/blog/thumbnail/ resize 560",
    "algolia:index": "node src/.vuepress/algolia_index.js",
    "perf:build": "node scripts/build-performance.js",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "lhci autorun --config=.lighthouserc.json",
    "test:all": "npm run test:unit && npm run test:e2e && npm run lighthouse",
    "serve": "npx http-server docs -p 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenotary/immudb.io.git"
  },
  "keywords": [
    "immudb",
    "immutable",
    "database",
    "codenotary",
    "vchain"
  ],
  "author": "Codenotary",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/codenotary/immudb.io/issues"
  },
  "homepage": "https://github.com/codenotary/immudb.io#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.6",
    "@vue/test-utils": "^2.5.0",
    "ansi-regex": "^5.0.1",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.11.12",
    "http-server": "^14.1.1",
    "jimp": "^1.6.0",
    "jsdom": "^25.0.0",
    "nth-check": "^2.1.1",
    "sass": "^1.103.1",
    "set-value": "^4.1.0",
    "sharp": "^0.35.3",
    "sharp-cli": "^5.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.10",
    "vitepress": "^1.0.0-rc.36",
    "vitest": "^3.2.6",
    "vue": "^3.5.42",
    "vue-tsc": "^1.8.27"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "algoliasearch": "^4.27.0",
    "axios": "^1.20.0",
    "cli-progress": "^3.11.2",
    "f": "^1.4.0",
    "fs": "0.0.1-security",
    "glob": "^8.0.3",
    "markdown-it": "^14.3.0",
    "reading-time": "^1.2.0",
    "slugify": "^1.6.9",
    "vue-github-button": "^1.2.0"
  },
  "overrides": {
    "glob-parent": "^5.1.2",
    "tar": "^7.5.7",
    "node-forge": "^1.3.0",
    "markdown-it": "^14.3.0",
    "trim-newlines": "^3.0.1",
    "yargs-parser": "^13.1.2",
    "got": "^11.8.5",
    "@babel/traverse": "^7.26.0",
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "body-parser": "^1.20.6",
    "braces": "^3.0.3",
    "sha.js": "^2.4.11",
    "ws": "^6.2.4",
    "webpack-dev-middleware": "^5.3.4",
    "send": "^0.19.1",
    "serve-static": "^1.16.2",
    "cookie": "^0.7.0",
    "path-to-regexp": "^0.1.13",
    "semver": "^7.5.4",
    "tar-fs": "^2.1.4",
    "xml2js": "^0.5.0",
    "brace-expansion": "^2.1.4",
    "express": "^4.21.1",
    "ip": "^2.0.1",
    "vue": "$vue",
    "vue-class-component": "^8.0.0-rc.1",
    "vue-property-decorator": "^10.0.0-rc.3",
    "form-data": "^4.0.6",
    "cross-spawn": "^7.0.5",
    "qs": "^6.15.3",
    "postcss": "^8.5.26",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.8",
    "tough-cookie": "^4.1.3",
    "@isaacs/brace-expansion": "^5.0.1",
    "js-yaml": "^3.15.1",
    "immutable": "^5.1.9",
    "nanoid": "^3.3.18",
    "linkify-it": "^5.0.2",
    "ip-address": "^10.5.0",
    "tmp": "^0.2.7",
    "rollup": "^4.62.4",
    "js-cookie": "^3.0.8",
    "basic-ftp": "^5.2.2",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "sharp": "^0.35.3",
    "sharp-cli": {
      "glob": "^11.1.0"
    }
  }
}
