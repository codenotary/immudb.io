{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server docs -p 8080",
      "startServerReadyPattern": "Available on",
      "url": [
        "http://localhost:8080/master/README.html",
        "http://localhost:8080/master/samples/go.html",
        "http://localhost:8080/master/connecting/sdks.html",
        "http://localhost:8080/master/production/performance-guide.html",
        "http://localhost:8080/1.9.6/README.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        },
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      },
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ],
        "speed-index": [
          "error",
          {
            "maxNumericValue": 3500
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
